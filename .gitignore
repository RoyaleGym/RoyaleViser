# Python
__pycache__/
*.pyc
*.pyd
.venv/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Build metadata
*.egg-info/
build/
dist/

# Regenerable outputs: window shots (S / F12, --shot), capture() clips and traces saved beside
# the viewer, except the pictures and clips the README shows
*.png
!docs/*.png
!docs/media/*.png
*.gif
*.mp4
!docs/media/*.gif
!docs/media/*.mp4
*.msgpack
logs/

# Recordings of real battles stay out of the repo; the synthetic ones the tests run on
# (tests/synthetic.py --write) are committed
*.jsonl
*.jsonl.gz
!tests/fixtures/*.jsonl.gz
reports/
tests/captures/

# Secrets and editor cruft
.env
.env.*
*.pem
*.key
.vscode/
.idea/
.DS_Store
Thumbs.db
